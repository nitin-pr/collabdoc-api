# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The same file is read by Django (config/settings.py) and by Docker Compose (docker-compose.yml).

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
# Defaults below work as-is with `docker compose up -d` (the container creates this DB and user).
# Not using Docker? Point these at your own PostgreSQL install (usually port 5432).
DB_NAME=collabdocs
DB_USER=collabdocs
DB_PASSWORD=collabdocs
DB_HOST=localhost
DB_PORT=5434
